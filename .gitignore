__pycache__/
*.pyc
*.pyo
node_modules/
rust/src-tauri/gen/
rust/target/
rust/dist/
rust/src-tauri/target/

# Backup files
*.backup.*

# FFmpeg log files
ffmpeg2pass-0.log*
*.mbtree

# Binaries are tracked (ffmpeg, ffprobe, vspipe, VS DLLs)

# Build artifacts
*.exe
*.dll
!PyEngine/bin/*.dll
!rust/src-tauri/bin/*.dll
!rust/src-tauri/bin/plugins/*.dll
!PyEngine/bin/plugins/*.dll
*.so
*.dylib

# Archives
*.zip
*.tar.gz
*.rar

# Reproducible private Python runtime (generated before CI/release builds)
.runtime-downloads/
rust/src-tauri/bin/python/

# Linux runtime and native build (generated locally)
cpp_engine/build-linux/
rust/src-tauri/bin/linux/
rust/src-tauri/bin/*-unknown-linux-gnu

# OS files
.DS_Store
Thumbs.db
desktop.ini

# AI tooling caches (generated, derived — safe to delete)
.token-savior-cache.json

# Local environment files (AGENTS.md: never commit .env*)
.env*

# Updater signing keys (NEVER commit private key)
rust/src-tauri/private_key.pem
rust/src-tauri/private_key_hex.txt
**/updater.key
**/updater.key.password
**/updater.linux.key
**/updater.linux.key.password

# Updater artifacts
rust/src-tauri/target/release/bundle/

# Generated native build files may contain local machine paths
cpp_engine/build/

# Linux signing backups belong outside the checkout
**/linux-updater.key
**/linux-updater.key.password
