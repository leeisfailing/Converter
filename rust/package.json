{
  "name": "converter-ui",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:installer": "tauri build --bundles nsis",
    "build:portable": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml && node scripts/build-portable.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "signer:generate": "node scripts/generate-updater-key.mjs",
    "release:check": "node scripts/check-release.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
