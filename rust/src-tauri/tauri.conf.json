{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Converter",
  "version": "3.0.0",
  "identifier": "com.converter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Converter by Lee",
        "width": 1024,
        "height": 768,
        "resizable": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' file: https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe",
      "bin/vspipe"
    ],
    "resources": {
      "bin/libvapoursynth.dll": "libvapoursynth.dll",
      "bin/vsscript.dll": "vsscript.dll",
      "bin/plugins/*": "plugins/"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
