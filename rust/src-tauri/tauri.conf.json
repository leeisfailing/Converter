{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Converter",
  "version": "3.0.0",
  "identifier": "com.converter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
"app": {
      "windows": [
        {
          "title": "Converter by Lee",
          "width": 1024,
          "height": 768,
          "resizable": false,
          "dragDropEnabled": true,
          "center": true,
          "decorations": false,
          "transparent": false
        }
      ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' ipc: http://tauri.localhost https://tauri.localhost https:; media-src 'self' blob:; font-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' ipc: http://tauri.localhost https://tauri.localhost http://localhost:1420 https:; media-src 'self' blob:; font-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe"
    ],
    "resources": {
      "../../PyEngine/__init__.py": "PyEngine/__init__.py",
      "../../PyEngine/__main__.py": "PyEngine/__main__.py",
      "../../PyEngine/core/*.py": "PyEngine/core/",
      "../../PyEngine/handlers/*.py": "PyEngine/handlers/",
      "../../PyEngine/workers/*.py": "PyEngine/workers/",
      "../../PyEngine/formats/*.py": "PyEngine/formats/",
      "../../PyEngine/bin/*": "PyEngine/bin/",
      "bin/python/": "PyEngine/bin/python/",
      "../../cpp_engine/build/gpu_engine.exe": "gpu_engine.exe"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNDgyMUM1NTlBMTk0N0UKUldSK2xLRlp4U0ZJWXZVbDR0L0ZPUSthVGZFRlQyNm82RTRwZUVLQWdLMTM2K2JaUXQxZWJaaDEK",
      "endpoints": [
        "https://github.com/leeisfailing/Converter/releases/latest/download/latest.json",
        "https://afodajwurtywdxeqoiym.supabase.co/functions/v1/update-manifest"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
