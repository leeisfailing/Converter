{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run setup:linux && npm run dev",
    "beforeBuildCommand": "npm run setup:linux && npm run build"
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "bin/converter-ffmpeg",
      "bin/converter-ffprobe"
    ],
    "resources": {
      "../../PyEngine/bin/*": null,
      "bin/python/": null,
      "bin/plugins/": null,
      "../../cpp_engine/build/gpu_engine.exe": null,
      "bin/linux/python/": "PyEngine/bin/python/",
      "../../cpp_engine/build-linux/gpu_engine": "gpu_engine"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Converter by Lee",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "dragDropEnabled": true,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/leeisfailing/Converter/releases/download/updater-linux/latest-linux.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMDUxM0VFOUEzQzE1QkIKUldTN0ZUeWE3aE1GT3pkMnQ4MHo3dFhsTWFpNDFkVmVJbjJZbTB4NnpxT3k1dTMxc2tOSnI4ZEQK"
    }
  }
}
